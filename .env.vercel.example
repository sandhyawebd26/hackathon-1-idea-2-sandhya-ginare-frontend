# Vercel → Project → Settings → Environment Variables
# Scope: enable Production AND Preview (branch deploys use Preview).
# Values: copy from your .env.local (same Supabase project, same keys).
# After saving → Redeploy (env changes do not update old client bundles).
#
# Do NOT commit .env.local or paste secrets into git.

# --- Supabase (browser: mapped at build via next.config.js) ---
NEXT_SUPABASE_URL=<same as NEXT_PUBLIC_SUPABASE_URL in .env.local>
NEXT_SUPABASE_ANON_KEY=<same as NEXT_PUBLIC_SUPABASE_ANON_KEY in .env.local — JWT anon, not sb_publishable_>

# --- Supabase (server only — email signup /api/auth/signup) ---
SUPABASE_SECRET_KEY=<same as .env.local sb_secret_…>

# --- Search / APIs ---
PROVIDER_MODE=duffel_test
AUTH_MODE=guest
NEXT_USE_FIXTURE=false
DUFFEL_ACCESS_TOKEN=<same as .env.local>
GEMINI_API_KEY=<same as .env.local>
AI_EXPLANATIONS_ENABLED=true

# --- Optional (not in your current .env.local) ---
# GROQ_API_KEY=
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true

# --- Not needed on Vercel if NEXT_SUPABASE_* are set ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  (local only; use JWT anon on Vercel as NEXT_SUPABASE_ANON_KEY)
