# Copy to .env.local. Never commit real keys.
# Do not prefix secrets with NEXT_PUBLIC_ — those are sent to the browser.

# Server: fixture | duffel_test | scrappa. Omit + valid duffel_test_ token → duffel_test.
PROVIDER_MODE=fixture
AUTH_MODE=guest
# Browser: true = skip /api/search (demo only). Set false to hit Duffel via POST /api/search.
NEXT_PUBLIC_USE_FIXTURE=true

# Public (browser-safe). In Supabase: Auth → Email → turn OFF “Confirm email” for hackathon signups.
# Auth → URL config: add http://localhost:3000/auth/callback and your Vercel URL + /auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional local redirect override (defaults to {origin}/auth/callback)
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Server only (Supabase Dashboard → Settings → API → service_role). Required for no-email signup.
SUPABASE_SECRET_KEY=
DUFFEL_ACCESS_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
SCRAPPA_API_KEY=
QUOTA_SCRAPPA_MONTHLY=400
AI_EXPLANATIONS_ENABLED=true
