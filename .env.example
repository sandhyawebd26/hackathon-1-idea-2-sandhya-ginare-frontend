# Copy to .env.local. Never commit real keys.
# Do not prefix secrets with NEXT_PUBLIC_ — those are sent to the browser.

PROVIDER_MODE=fixture
AUTH_MODE=guest
NEXT_PUBLIC_USE_FIXTURE=true

# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only
SUPABASE_SECRET_KEY=
DUFFEL_ACCESS_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
SCRAPPA_API_KEY=
QUOTA_SCRAPPA_MONTHLY=400
AI_EXPLANATIONS_ENABLED=true
