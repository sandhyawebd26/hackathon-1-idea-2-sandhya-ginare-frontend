# Copy to .env.local. Never commit real keys.
# Do not prefix secrets with NEXT_PUBLIC_ — those are sent to the browser.

# Server: fixture | duffel_test | scrappa. Omit + valid duffel_test_ token → duffel_test.
PROVIDER_MODE=fixture
AUTH_MODE=guest
# Browser: true = bundled fixtures only. false = call POST /api/search (use false on Vercel demo).
NEXT_PUBLIC_USE_FIXTURE=false

# Browser-safe Supabase (local: NEXT_PUBLIC_*; Vercel: NEXT_SUPABASE_* is enough — next.config.js inlines at build).
# Auth → Email: turn OFF “Confirm email” for hackathon signups.
# Auth → URL config: http://localhost:3000/auth/callback and https://<vercel>/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Vercel-only aliases (same values; no NEXT_PUBLIC_ keys required on Vercel):
# NEXT_SUPABASE_URL=
# NEXT_SUPABASE_ANON_KEY=
# Optional local redirect override (defaults to {origin}/auth/callback)
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Server only (Supabase Dashboard → Settings → API → service_role). Required for no-email email signup.
# Google login (optional): enable in Supabase, then set NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
SUPABASE_SECRET_KEY=
DUFFEL_ACCESS_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
SCRAPPA_API_KEY=
QUOTA_SCRAPPA_MONTHLY=400
AI_EXPLANATIONS_ENABLED=true
